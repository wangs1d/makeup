      "area": "eyebrow",
      "regions": [
        "eyebrow"
      ],
      "instruction": "眉色比发色浅一档，画圆润弧度不要硬眉峰"
    },
    {
      "order": 3,
      "area": "eye",
      "regions": [
        "eyeshadow",
        "eyeliner"
      ],
      "instruction": "玫瑰粉铺眼窝、深一号压眼尾三角，下睑后半段带过；眼线拉长上扬"
    },
    {
      "order": 4,
      "area": "blush",
      "regions": [
        "blush",
        "highlight"
      ],
      "instruction": "微醺画法：腮红扫在颧骨至眼下，少量叠两次；高光提亮颧骨和唇峰"
    },
    {
      "order": 5,
      "area": "lip",
      "regions": [
        "lipstick"
      ],
      "instruction": "水红唇釉涂满全唇，中央再叠一层做玻璃唇"
    }
